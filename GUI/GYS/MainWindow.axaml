<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="IpekYoluGYS.MainWindow"
        Title="İpek Yolu Geçiş Yönetim Sistemi"
        Width="1300" Height="850" MinWidth="1100" MinHeight="700"
        Background="#F3F3F3">

    <Grid RowDefinitions="*, Auto">
        <TabControl Grid.Row="0" Margin="10" Background="White">
            
            <TabItem Header="📋 Hareket Logları">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" MinWidth="260" MaxWidth="400"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Border Grid.Column="0" Margin="10" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="5" Padding="15">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Gelişmiş Filtreleme" FontWeight="Bold" FontSize="14" Foreground="#555" Margin="0,0,0,10"/>
        
                                <TextBlock Text="İsim ile Ara:" FontWeight="Bold"/>
                                <AutoCompleteBox x:Name="TxtLogSearch" Watermark="İsimle arayın..." FilterMode="Contains" TextChanged="TxtLogSearch_TextChanged" Height="36"/>

                                <TextBlock Text="Başlangıç Tarihi:" FontWeight="Bold" Margin="0,10,0,0"/>
                                <CalendarDatePicker x:Name="DpLogStart" Height="36" CornerRadius="4" HorizontalAlignment="Stretch" Watermark="Başlangıç seçin..." VerticalContentAlignment="Center"/>
                                
                                <TextBlock Text="Bitiş Tarihi:" FontWeight="Bold"/>
                                <CalendarDatePicker x:Name="DpLogEnd" Height="36" CornerRadius="4" HorizontalAlignment="Stretch" Watermark="Bitiş seçin..." VerticalContentAlignment="Center"/>

                                <TextBlock Text="Kayıt Türü:" FontWeight="Bold" Margin="0,10,0,0"/>
                                <ComboBox x:Name="CmbLogTur" SelectedIndex="0" Height="36" CornerRadius="4" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" SelectionChanged="CmbLogTur_SelectionChanged">
                                    <ComboBoxItem>TÜMÜ</ComboBoxItem>
                                    <ComboBoxItem>PERSONEL</ComboBoxItem>
                                    <ComboBoxItem>GONULLU</ComboBoxItem>
                                </ComboBox>

                                <Button Content="🔍 Logları Filtrele" Click="BtnRefreshLogs_Click" HorizontalAlignment="Stretch" CornerRadius="4" Background="#0078D7" Foreground="White" Height="38" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="0,15,0,0"/>
                                <Button Content="🔄 Yenile" Click="BtnRefreshLogs_Click" CornerRadius="4" HorizontalAlignment="Stretch" Height="38" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <GridSplitter Grid.Column="1" Width="5" Background="#E0E0E0" ResizeDirection="Columns" ShowsPreview="True"/>

                    <Grid Grid.Column="2" RowDefinitions="*, Auto" Margin="10,10,10,0">
                        <DataGrid x:Name="GridLogs" x:CompileBindings="False" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" RowHeight="32" LoadingRow="GridLogs_LoadingRow" DoubleTapped="GridLogs_DoubleTapped" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="5" CanUserResizeColumns="True" CanUserReorderColumns="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="✏️ Saati Düzenle" Click="MenuEditTime_Click"/>
                                    <Separator/>
                                    <MenuItem Header="🖥️ Düzenleyen PC Bilgisini Göster" Click="MenuShowPc_Click"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tarih/Saat" Binding="{Binding Zaman}" Width="190"/>
                                <DataGridTextColumn Header="Ad Soyad" Binding="{Binding AdSoyad}" Width="*"/>
                                <DataGridTextColumn Header="Rol" Binding="{Binding Rol}" Width="120"/>
                                <DataGridTextColumn Header="İşlem" Binding="{Binding IslemTipi}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10" Spacing="20">
                            <Button x:Name="BtnPrevPage" Content="◀ Önceki Sayfa" Click="BtnPrevPage_Click" CornerRadius="4" Height="34" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                            <TextBlock x:Name="LblPageInfo" Text="Sayfa 1 / 1" VerticalAlignment="Center" FontWeight="Bold"/>
                            <Button x:Name="BtnNextPage" Content="Sonraki Sayfa ▶" Click="BtnNextPage_Click" CornerRadius="4" Height="34" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="👤 Kullanıcı Yönetimi">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" MinWidth="260" MaxWidth="400"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Border Grid.Column="0" Margin="10" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="5" Padding="15">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Spacing="10">
                                <TextBlock x:Name="LblUserFormTitle" Text="Yeni Kişi Ekle" FontWeight="Bold" FontSize="14" Foreground="#555" Margin="0,0,0,10"/>
                                
                                <TextBlock Text="Kart UID:" FontWeight="Bold"/>
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBox Grid.Column="0" x:Name="TxtUid" Height="36" CornerRadius="4" VerticalContentAlignment="Center" Watermark="Kart okutun veya giriniz..."/>
                                    <Button x:Name="BtnCek" Grid.Column="1" Content="📡 Çek" Click="BtnCek_Click" Margin="5,0,0,0" CornerRadius="4" Height="36" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                                </Grid>

                                <TextBlock Text="Kayıt Türü:" FontWeight="Bold"/>
                                <ComboBox x:Name="CmbRol" SelectedIndex="0" HorizontalAlignment="Stretch" CornerRadius="4" Height="36" VerticalContentAlignment="Center">
                                    <ComboBoxItem>PERSONEL</ComboBoxItem>
                                    <ComboBoxItem>GONULLU</ComboBoxItem>
                                </ComboBox>

                                <TextBlock Text="Ad Soyad:" FontWeight="Bold"/>
                                <TextBox x:Name="TxtAd" Height="36" CornerRadius="4" VerticalContentAlignment="Center" Watermark="Örn: Ahmet Yılmaz"/>

                                <TextBlock Text="TC Kimlik No:" FontWeight="Bold"/>
                                <TextBox x:Name="TxtTc" Height="36" CornerRadius="4" VerticalContentAlignment="Center" MaxLength="11" Watermark="11 haneli TC giriniz..."/>

                                <Button x:Name="BtnSaveUser" Content="KİŞİYİ KAYDET" Click="BtnSaveUser_Click" Background="#27ae60" Foreground="White" CornerRadius="4" HorizontalAlignment="Stretch" Margin="0,15,0,0" Height="38" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                                <Button x:Name="BtnCancelEdit" Content="İptal Et" Click="BtnCancelEdit_Click" CornerRadius="4" HorizontalAlignment="Stretch" IsVisible="False" Height="38" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <GridSplitter Grid.Column="1" Width="5" Background="#E0E0E0" ResizeDirection="Columns" ShowsPreview="True"/>

                    <Grid Grid.Column="2" RowDefinitions="Auto, *" Margin="10">
                        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,10">
                            <TextBlock Grid.Column="0" Text="Kayıtlı Kişiler" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" Margin="0,0,15,0"/>
                            <AutoCompleteBox Grid.Column="1" x:Name="TxtUserFilter" Watermark="İsimle filtrele..." FilterMode="Contains" TextChanged="TxtUserFilter_TextChanged" Height="36" VerticalAlignment="Center"/>
                            <Button Grid.Column="2" Content="🔄 Yenile" Click="BtnRefreshUsers_Click" CornerRadius="4" Margin="10,0,0,0" Height="36" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                        </Grid>

                        <DataGrid x:Name="GridUsers" x:CompileBindings="False" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" RowHeight="32" LoadingRow="GridUsers_LoadingRow" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="5" CanUserResizeColumns="True" CanUserReorderColumns="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Giriş Yaptır" Click="MenuForceGiris_Click"/>
                                    <MenuItem Header="Çıkış Yaptır" Click="MenuForceCikis_Click"/>
                                    <Separator/>
                                    <MenuItem Header="📅 Haftalık Çalışma Analizi" Click="MenuShowWeeklyHours_Click"/>
                                    <Separator/>
                                    <MenuItem Header="✏️ Kişiyi Düzenle" Click="MenuEditUser_Click"/>
                                    <Separator/>
                                    <MenuItem Header="🗑️ Kişiyi Sil" Click="MenuDeleteUser_Click"/>
                                    <Separator/>
                                    <MenuItem Header="📊 Excel Raporu Al" Click="MenuExportExcel_Click"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Sıra" Binding="{Binding Sira}" Width="80"/>
                                <DataGridTextColumn Header="Ad Soyad" Binding="{Binding AdSoyad}" Width="*"/>
                                <DataGridTextColumn Header="TC Kimlik No" Binding="{Binding TC}" Width="150"/>
                                <DataGridTextColumn Header="Rol" Binding="{Binding Rol}" Width="120"/>
                                <DataGridTextColumn Header="Durum" Binding="{Binding Durum}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>
            
            <TabItem Header="🗓️ İzin Yönetimi">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" MinWidth="260" MaxWidth="400"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Border Grid.Column="0" Margin="10" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="5" Padding="15">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Spacing="10">
                                <TextBlock Text="İzin İşlemleri" FontWeight="Bold" FontSize="14" Foreground="#555" Margin="0,0,0,10"/>
                                
                                <TextBlock Text="Personel / Gönüllü Adı:" FontWeight="Bold"/>
                                <AutoCompleteBox x:Name="TxtIzinAd" Watermark="İsim seçin..." FilterMode="Contains" Height="36"/>
                                
                                <TextBlock Text="Başlangıç Tarihi:" FontWeight="Bold"/>
                                <CalendarDatePicker x:Name="DpIzinBas" Height="36" CornerRadius="4" HorizontalAlignment="Stretch" Watermark="Tarih seçin..." VerticalContentAlignment="Center"/>
                                
                                <TextBlock Text="Bitiş Tarihi:" FontWeight="Bold"/>
                                <CalendarDatePicker x:Name="DpIzinBit" Height="36" CornerRadius="4" HorizontalAlignment="Stretch" Watermark="Tarih seçin..." VerticalContentAlignment="Center"/>
                                
                                <TextBlock Text="Açıklama:" FontWeight="Bold"/>
                                <TextBox x:Name="TxtAciklama" Height="80" CornerRadius="4" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Watermark="İzin nedenini veya açıklamasını giriniz..."/>
                                
                                <Button x:Name="BtnAddIzin" Content="➕ İzin Ekle" Click="BtnAddIzin_Click" Background="#0078D7" Foreground="White" CornerRadius="4" HorizontalAlignment="Stretch" Margin="0,10,0,0" Height="38" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                                <Button x:Name="BtnCancelIzinEdit" Content="İptal Et" Click="BtnCancelIzinEdit_Click" CornerRadius="4" HorizontalAlignment="Stretch" IsVisible="False" Height="38" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                                <Button Content="🔄 Yenile" Click="BtnRefreshIzin_Click" CornerRadius="4" HorizontalAlignment="Stretch" Height="38" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <GridSplitter Grid.Column="1" Width="5" Background="#E0E0E0" ResizeDirection="Columns" ShowsPreview="True"/>

                    <Grid Grid.Column="2" RowDefinitions="Auto, *" Margin="10">
                        <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Margin="0,0,0,10">
                            <TextBlock Grid.Column="0" Text="Kayıtlı İzinler" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" Margin="0,0,15,0"/>
                            <AutoCompleteBox Grid.Column="1" x:Name="TxtIzinFilter" Watermark="İsimle filtrele..." FilterMode="Contains" TextChanged="TxtIzinFilter_TextChanged" Height="36" VerticalAlignment="Center"/>
                        </Grid>

                        <DataGrid x:Name="GridIzinler" x:CompileBindings="False" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" RowHeight="32" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="5" CanUserResizeColumns="True" CanUserReorderColumns="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="📄 Açıklama Detayını Göster" Click="MenuShowIzinAciklama_Click"/>
                                    <Separator/>
                                    <MenuItem Header="✏️ İzni Düzenle" Click="MenuEditIzin_Click"/>
                                    <Separator/>
                                    <MenuItem Header="🗑️ İzni Sil" Click="MenuDeleteIzin_Click"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Ad Soyad" Binding="{Binding AdSoyad}" Width="200"/>
                                <DataGridTextColumn Header="Başlangıç" Binding="{Binding BaslangicTarihi, StringFormat=\{0:yyyy-MM-dd\}}" Width="130"/>
                                <DataGridTextColumn Header="Bitiş" Binding="{Binding BitisTarihi, StringFormat=\{0:yyyy-MM-dd\}}" Width="130"/>
                                <DataGridTextColumn Header="Açıklama" Binding="{Binding Aciklama}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="1" Background="#EAEAEA" BorderBrush="#D0D0D0" BorderThickness="0,1,0,0" Padding="12,6">
            <TextBlock x:Name="LblStatus" Foreground="#555555" Text="Sistem Hazır" VerticalAlignment="Center" FontSize="12"/>
        </Border>
        
        <Border x:Name="OverlayDialog" Background="#40000000" IsVisible="False" ZIndex="100" Grid.Row="0" Grid.RowSpan="2">
            <Border Background="White" Width="380" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20" CornerRadius="10" BoxShadow="0 10 30 0 #40000000">
                <StackPanel Spacing="15">
                    <TextBlock x:Name="DialogTitle" Text="Başlık" FontWeight="Bold" FontSize="16"/>
                    <ScrollViewer MaxHeight="400">
                        <TextBlock x:Name="DialogMessage" Text="Mesaj" TextWrapping="Wrap" LineHeight="22"/>
                    </ScrollViewer>
                    <TextBox x:Name="DialogInput" IsVisible="False" Height="36" CornerRadius="4" VerticalContentAlignment="Center" Margin="0,10,0,0" KeyDown="DialogInput_KeyDown"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                        <Button x:Name="BtnDialogCancel" Content="İptal" Click="BtnDialogCancel_Click" IsVisible="False" CornerRadius="4" Height="34" VerticalContentAlignment="Center"/>
                        <Button x:Name="BtnDialogOk" Content="Tamam" Click="BtnDialogOk_Click" Background="#0078D7" Foreground="White" Width="80" CornerRadius="4" HorizontalContentAlignment="Center" Height="34" VerticalContentAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>